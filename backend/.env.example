# ==============================
# SGIAC BACKEND - VARIABLES DE ENTORNO
# ==============================

# Cadena de conexion pooled (usada por Prisma Client en runtime)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Cadena de conexion directa (usada por Prisma para migraciones / db pull)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres"

# JWT
JWT_SECRET="cambia_esto_por_un_secreto_largo_y_aleatorio"
JWT_REFRESH_SECRET="cambia_esto_por_otro_secreto_largo_y_aleatorio"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Supabase
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="tu-anon-key"

# Servidor
PORT=4000
NODE_ENV="development"

# Frontend
FRONTEND_URL="http://localhost:5173"

# Cookies
COOKIE_SECURE="false"

# Correos: registro, recuperacion de contrasena y segundo paso del login.
# Pruebas: API de Mailtrap Email Sandbox (no son credenciales SMTP).
MAIL_PROVIDER="mailtrap"
MAIL_FROM="SGIAC <acceso@sgiac.test>"
MAILTRAP_API_TOKEN=""
MAILTRAP_INBOX_ID=""

# Mailtrap Email Sending (entrega real): MAIL_PROVIDER="mailtrap-sending".
# Sending Domains -> dominio verificado -> Integration -> API.
MAILTRAP_SENDING_TOKEN=""
MAILTRAP_SENDING_FROM=""

# Envio real: cambiar MAIL_PROVIDER a "resend", completar RESEND_API_KEY
# y cambiar MAIL_FROM por un remitente de un dominio verificado en Resend.
RESEND_API_KEY=""
# LOGIN_MAIL_FROM sigue admitido si no se define MAIL_FROM.

# Gmail / Google Workspace: cambiar MAIL_PROVIDER a "smtp" y MAIL_FROM
# al mismo correo de SMTP_USERNAME. SMTP_PASSWORD es una contrasena de aplicacion.
# SMTP_ENCRYPTION: "tls" = STARTTLS (587), "ssl" = TLS directo (465).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="acceso@tudominio.edu.bo"
SMTP_PASSWORD=""
SMTP_ENCRYPTION="tls"
