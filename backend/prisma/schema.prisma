generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  idUsuario               BigInt                   @id @default(autoincrement()) @map("id_usuario")
  nombreCompleto          String                   @map("nombre_completo") @db.VarChar(150)
  correo                  String                   @unique @map("correo") @db.VarChar(150)
  estado                  String                   @default("ACTIVO") @map("estado") @db.VarChar(20)
  fechaCreacion           DateTime                 @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  contrasenaHash          String?                  @map("contrasena_hash")
  correoVerificado        Boolean                  @default(false) @map("correo_verificado")
  debeCambiarPassword     Boolean                  @default(false) @map("debe_cambiar_password")
  fechaActualizacion      DateTime?                @updatedAt @map("fecha_actualizacion") @db.Timestamp(6)
  twoFactorEnabled        Boolean                  @default(false) @map("two_factor_enabled")
  bitacoras               Bitacora[]
  cierre_gestion          cierre_gestion[]
  comunicado              comunicado[]
  consulta_faq            consulta_faq[]
  emailVerificationTokens EmailVerificationToken[]
  estudiante              estudiante?
  historial_comunicado    historial_comunicado[]
  historial_ficha         historial_ficha[]
  jornada_atencion        jornada_atencion[]
  passwordResetTokens     PasswordResetToken[]
  pregunta_faq            pregunta_faq[]
  refreshTokens           RefreshToken[]
  roles                   UsuarioRol[]
  permisos                PermisoUsuario[]

  @@map("usuario")
}

model Rol {
  idRol       BigInt       @id @default(autoincrement()) @map("id_rol")
  nombre      String       @unique @map("nombre") @db.VarChar(80)
  descripcion String?      @map("descripcion")
  estado      String       @default("ACTIVO") @map("estado") @db.VarChar(20)
  usuarios    UsuarioRol[]

  @@map("rol")
}

model PermisoUsuario {
  idUsuario BigInt    @map("id_usuario")
  modulo    String    @db.VarChar(40)
  desde     DateTime? @db.Timestamptz(6)
  hasta     DateTime? @db.Timestamptz(6)
  usuario   Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@id([idUsuario, modulo])
  @@map("permiso_usuario")
}

model UsuarioRol {
  idUsuario       BigInt   @map("id_usuario")
  idRol           BigInt   @map("id_rol")
  fechaAsignacion DateTime @default(now()) @map("fecha_asignacion") @db.Timestamptz(6)
  estado          String   @default("ACTIVO") @db.VarChar(20)
  rol             Rol      @relation(fields: [idRol], references: [idRol], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario_rol_rol")
  usuario         Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario_rol_usuario")

  @@id([idUsuario, idRol])
  @@map("usuario_rol")
}

model Bitacora {
  idBitacora         BigInt   @id @default(autoincrement()) @map("id_bitacora")
  accion             String   @map("accion") @db.VarChar(100)
  entidadAfectada    String   @map("entidad_afectada") @db.VarChar(100)
  idRegistroAfectado String?  @map("id_registro_afectado") @db.VarChar(100)
  detalle            String?  @map("detalle")
  fechaHora          DateTime @default(now()) @map("fecha_hora") @db.Timestamptz(6)
  idUsuario          BigInt?  @map("id_usuario")
  usuario            Usuario? @relation(fields: [idUsuario], references: [idUsuario], onUpdate: NoAction, map: "fk_bitacora_usuario")

  @@map("bitacora")
}

model RefreshToken {
  idRefreshToken Int      @id @default(autoincrement()) @map("id_refresh_token")
  idUsuario      BigInt   @map("id_usuario")
  tokenHash      String   @unique @map("token_hash")
  expiraEn       DateTime @map("expira_en") @db.Timestamp(6)
  revocado       Boolean  @default(false) @map("revocado")
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamp(6)
  userAgent      String?  @map("user_agent")
  ip             String?  @map("ip")
  usuario        Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction)

  @@map("refresh_token")
}

model PasswordResetToken {
  idToken   Int      @id @default(autoincrement()) @map("id_token")
  idUsuario BigInt   @map("id_usuario")
  codigo    String   @map("codigo")
  expiraEn  DateTime @map("expira_en") @db.Timestamp(6)
  usado     Boolean  @default(false) @map("usado")
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamp(6)
  usuario   Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction)

  @@map("password_reset_token")
}

model EmailVerificationToken {
  idToken   Int      @id @default(autoincrement()) @map("id_token")
  idUsuario BigInt   @map("id_usuario")
  codigo    String   @map("codigo")
  expiraEn  DateTime @map("expira_en") @db.Timestamp(6)
  usado     Boolean  @default(false) @map("usado")
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamp(6)
  usuario   Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction)

  @@map("email_verification_token")
}

